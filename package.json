{
  "name": "villains-club",
  "version": "0.1.0",
  "private": true,
  "description": "The Villains Club — Electron shell, club UI, and minigames",
  "author": "The Villains Club",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "electron": "electron .",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"vite.config.ts\" \"vitest.config.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim:fateseal": "npx tsx scripts/sim-fateseal.ts",
    "sim:itch": "npx tsx scripts/sim-seven-year-itch.ts",
    "sim:oubliette": "npx tsx scripts/sim-oubliette.ts",
    "sim:masterson": "npx tsx scripts/sim-masterson.ts",
    "sim:royale": "npx tsx scripts/sim-lignee-royale.ts",
    "sim:all": "npx tsx scripts/sim-all.ts",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "dist:electron:linux": "npm run build && electron-builder --linux dir --publish never",
    "dist:electron:win": "npm run build && electron-builder --win dir --publish never",
    "dist:electron:mac": "npm run build && electron-builder --mac dir --publish never",
    "workspace:update": "bash scripts/workspace-update.sh",
    "rename-bands:camelcase": "node scripts/rename-bands-to-camelcase.mjs",
    "testall": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@mantine/core": "7.17.8",
    "@mantine/hooks": "7.17.8",
    "framer-motion": "12.38.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.14.1",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.17",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.5.0",
    "concurrently": "9.2.1",
    "electron": "38.8.6",
    "electron-builder": "26.8.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "postcss": "8.5.10",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "sass": "1.99.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.2",
    "vite": "7.3.2",
    "vitest": "3.2.4",
    "wait-on": "9.0.5"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "build": {
    "appId": "club.villains.desktop",
    "productName": "The Villains Club",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.cjs",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Game"
    },
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.games"
    }
  }
}